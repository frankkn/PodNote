# 允許的前端來源（CORS），逗號分隔
# Expo web 預設跑在 8081；舊版 webpack 是 19006
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# faster-whisper 設定（免費 CPU 建議 small / int8）
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# VAD 需要 onnxruntime，Windows 本機常載入失敗，預設關閉；Linux/Docker 可設 true
WHISPER_VAD=false
# 分段轉檔每段秒數（長節目用）
CHUNK_SECONDS=300

# 下載暫存目錄
DOWNLOAD_DIR=./_data

# 防濫用
MAX_AUDIO_SECONDS=3600
MAX_CONCURRENT_JOBS=1
RATE_LIMIT_PER_HOUR=5

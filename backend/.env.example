# 允許的前端來源（CORS），逗號分隔
# Expo web 預設跑在 8081；舊版 webpack 是 19006
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# 慢速模式（CPU，faster-whisper；免費 CPU 建議 small / int8）
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# VAD 需要 onnxruntime，Windows 本機常載入失敗，預設關閉；Linux/Docker 可設 true
WHISPER_VAD=false
# CPU 分段轉檔每段秒數（長節目用）
CHUNK_SECONDS=300

# 快速模式（GPU，Groq/OpenAI 相容轉錄 API）
# 注意：API Key 由「使用者」在前端設定頁輸入、隨請求送來，後端不在此設定 key。
STT_MODEL=whisper-large-v3
STT_BASE_URL=https://api.groq.com/openai/v1
# GPU 分段秒數（16kHz 單聲道 wav，600 秒 ≈ 19MB，低於 25MB 單檔上限）
STT_CHUNK_SECONDS=600

# 下載暫存目錄
DOWNLOAD_DIR=./_data

# 防濫用
MAX_AUDIO_SECONDS=3600        # CPU 模式上限（秒）
MAX_AUDIO_SECONDS_GPU=7200    # GPU 模式上限（秒）
MAX_CPU_CONCURRENT_JOBS=1     # CPU 同時一個
MAX_CONCURRENT_JOBS=4         # 所有任務同時上限
RATE_LIMIT_PER_HOUR=10

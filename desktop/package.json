{
  "name": "podnote-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "PodNote desktop MVP for local YouTube/Podcast audio download and transcription.",
  "author": "PodNote",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test:download": "node scripts/test-download.js",
    "test:transcribe": "node scripts/test-transcribe.js",
    "test:workflow": "node scripts/test-workflow.js",
    "test:local": "node scripts/test-local.js",
    "test:notes": "node scripts/test-notes.js",
    "test:electron": "npx --yes electron@42.3.3 . --smoke-test",
    "fetch:bin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-binaries.ps1",
    "dist": "npm run fetch:bin && electron-builder --win nsis",
    "release": "npm run fetch:bin && electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.podnote.desktop",
    "productName": "PodNote",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "yt-dlp.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "frankkn",
        "repo": "PodNote"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^25.1.8"
  }
}
